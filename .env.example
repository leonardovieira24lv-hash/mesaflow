# Supabase — projeto do MesaFlow
# Nunca commitar o .env.local real. Este arquivo é só o template.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Somente uso em Route Handlers / server-side (nunca expor ao cliente).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# FORKO Printer — Etapa 7 (2026-08-25). Formato "owner/repo" do
# repositório GitHub onde as Releases do FORKO Printer são publicadas —
# usado só pra montar o link de download
# (github.com/{repo}/releases/latest/download/FORKO-Printer-Setup.exe,
# um link estável do próprio GitHub que sempre aponta pra versão mais
# recente, sem precisar saber o número da versão). Deixado sem valor
# aqui de propósito — enquanto ausente, o botão de download fica
# desabilitado em vez de apontar pra um link quebrado.
NEXT_PUBLIC_FORKO_PRINTER_GITHUB_REPO=
